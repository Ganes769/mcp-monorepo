# Backend Environment Variables

# Database Configuration
DATABASE_PATH=database.sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Authentication Configuration
BETTER_AUTH_SECRET=your-super-secret-auth-key-change-this-in-production
# Local: http://localhost:3000
# Production (same-origin via frontend rewrite): https://mcp-monorepo.vercel.app
# Production (direct cross-origin API): https://mcp-monorepo-yccf.vercel.app
BETTER_AUTH_BASE_URL=http://localhost:3000
# Optional: force cookie SameSite (none|lax). https base URLs default to none.
# AUTH_COOKIE_SAME_SITE=none

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration (Frontend URLs)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Frontend Environment Variables

# API Configuration
# Local + production both use /api (Vite proxy locally; vercel.json rewrite on Vercel).
# Only set an absolute URL if you intentionally call the API cross-origin.
VITE_API_URL=/api

# Development Configuration
VITE_NODE_ENV=development

# Optional: Analytics, monitoring, etc.
# VITE_ANALYTICS_ID=your-analytics-id
# VITE_SENTRY_DSN=your-sentry-dsn
